# ── AI mode ──────────────────────────────────────────────
# false = live Meta API (needs META_API_KEY) with mock fallback.
# true = fully offline mock demo, no key needed.
USE_MOCK=false

# Paste key when issued. Leave empty → auto-mock.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

SAM_MODEL=sam-3.1
MUSE_IMAGE_MODEL=muse-image-1.0
MUSE_TEXT_MODEL=muse-spark-1.3

# If live call fails / endpoints not finalized → use local mock
ALLOW_MOCK_FALLBACK=true
META_TIMEOUT_SECONDS=90
MOCK_LATENCY_MS=350

# ── Go-live checklist (when API arrives) ─────────────────
# 1) META_API_KEY=...
# 2) Confirm META_API_BASE_URL against Meta docs
# 3) USE_MOCK=false
# 4) Restart backend
# 5) GET /api/status?probe=true
# 6) Adjust TODO paths in backend/app/services/meta_client.py if schema differs
# See INTEGRATION.md

# ── Engineering constants ────────────────────────────────
PANEL_KW=0.4
PEAK_SUN_HOURS=1450
COST_PER_KW_USD=800
TARIFF_PER_KWH_USD=0.12
PANEL_WIDTH_M=1.7
PANEL_HEIGHT_M=1.0
SETBACK_M=0.5
DEFAULT_METERS_PER_PIXEL=0.05
DERATE=0.85

# ── Upload + retention guards ────────────────────────────
MAX_UPLOAD_MB=15
MIN_UPLOAD_PX=64
MAX_UPLOAD_MP=50.0
STATIC_RETENTION_DAYS=7
RATE_LIMIT_PER_MINUTE=60

# ── Google Maps (optional — map roof picker) ─────────────
# Prefer HTTP-referrer restriction on the key:
#   http://localhost:5173/*
#   http://127.0.0.1:5173/*
# Frontend fetches Static Maps in-browser (referrer-safe).
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
